{
  "name": "ascension-city-map",
  "main": "src/cloudflare.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "durable_objects": {
    "bindings": [
      { "name": "AI_BUDGET", "class_name": "AIBudget" },
      { "name": "COMPLAINTS", "class_name": "Complaints" },
      { "name": "TEAM_WORKSPACE", "class_name": "TeamWorkspaceDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AIBudget"] },
    { "tag": "v2-complaints", "new_sqlite_classes": ["Complaints"] },
    { "tag": "v3-team-workspace", "new_sqlite_classes": ["TeamWorkspaceDurableObject"] }
  ],
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "2026092312",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://ascension-city-map.azamatbreach.workers.dev",
    "WORKSPACE_ORIGIN": "https://ascension-city-map.azamatbreach.workers.dev",
    "TELEGRAM_BOT_USERNAME": "Ascension_City_bot",
    "OPENAI_MODEL": "gpt-6-astra",
    "AI_MAX_REQUESTS": "100",
    "AI_REQUESTS_PER_MINUTE": "10",
    "AI_MAX_CONCURRENT": "2"
  }
}
