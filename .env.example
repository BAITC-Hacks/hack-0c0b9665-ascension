OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
PORT=3000
HOST=127.0.0.1
# Complaints are local and use explicitly labeled rules until an AI provider is configured.
ADMIN_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Optional support contact: https://t.me/username or @username. Leave blank for the help-only section.
TELEGRAM_SUPPORT_URL=
PUBLIC_BASE_URL=
# Public HTTPS site for npm run bot:hosted; falls back to PUBLIC_BASE_URL.
# Use your own deployment origin. Keep this set when PUBLIC_BASE_URL points to localhost.
TELEGRAM_HOSTED_URL=
# Optional absolute path outside public; default is var/complaints.json.
COMPLAINTS_FILE=
# Polling forwards updates to the running server so only one process writes the store.
# npm start, then npm run bot:local explicitly disables the hosted webhook without dropping pending updates.
# Stop local polling, then npm run bot:hosted to resume hosting. npm run bot:status checks the mode.
BOT_SERVER_URL=http://127.0.0.1:3000
