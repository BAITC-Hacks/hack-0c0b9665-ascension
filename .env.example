OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
PORT=3000
HOST=127.0.0.1
# Complaints are local and use explicitly labeled rules until an AI provider is configured.
ADMIN_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
# Optional absolute path outside public; default is var/complaints.json.
COMPLAINTS_FILE=
# Polling forwards updates to the running server so only one process writes the store.
BOT_SERVER_URL=http://127.0.0.1:3000
