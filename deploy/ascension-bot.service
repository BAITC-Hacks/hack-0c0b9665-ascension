[Unit]
Description=Ascension Telegram polling forwarder
Wants=network-online.target ascension.service
After=network-online.target ascension.service

[Service]
Type=simple
User=ascension
Group=ascension
WorkingDirectory=/opt/ascension
EnvironmentFile=/etc/ascension.env
ExecStart=/usr/bin/node /opt/ascension/src/telegram-poll.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
